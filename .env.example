GEMINI_API_KEY=your_api_key_here

# --- Google sign-in + Elo (Supabase) ---
# Backend (Render): Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx   # hoặc SUPABASE_SERVICE_ROLE_KEY (khoá JWT kiểu cũ). KHÔNG đưa khoá này lên frontend.

# Frontend (Vercel / frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # publishable key (hoặc anon key kiểu cũ)
